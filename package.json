{
  "name": "packetboat-workspace",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "tauri": "cd crates/packetboat-desktop && tauri",
    "dev:desktop": "cd crates/packetboat-desktop && tauri dev",
    "dev:web": "pnpm --filter packetboat-desktop-ui run dev",
    "build": "pnpm --filter packetboat-desktop-ui run build",
    "build:desktop": "cd crates/packetboat-desktop && tauri build",
    "build:desktop:check": "cd crates/packetboat-desktop && tauri build --no-bundle",
    "test": "pnpm --filter packetboat-desktop-ui run test",
    "lint": "pnpm --filter packetboat-desktop-ui run lint",
    "typecheck": "pnpm --filter packetboat-desktop-ui run typecheck",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
