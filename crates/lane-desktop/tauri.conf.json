{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LANE",
  "identifier": "com.lane.fileshare",
  "build": {
    "beforeDevCommand": "pnpm --filter lane-desktop-ui run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --filter lane-desktop-ui run build",
    "frontendDist": "../../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LANE · 局域网投递站",
        "width": 1180,
        "height": 780,
        "minWidth": 400,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://127.0.0.1:5173",
        "connect-src": "'self' ipc: http://ipc.localhost ws: wss: http://127.0.0.1:5173",
        "img-src": "'self' blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LANE",
    "copyright": "Copyright © 2026 LANE",
    "category": "Utility",
    "shortDescription": "局域网文件投递站",
    "longDescription": "LANE 是一款运行在 Windows 上的局域网文件投递工具：桌面端与浏览器之间通过配对认证共享和接收文件，全程本地直连，不依赖任何云服务。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
